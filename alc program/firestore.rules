rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all users for development
    // WARNING: These rules are for development only. Update for production.
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Example of more secure rules (commented out for now)
    /*
    match /students/{studentId} {
      allow read: if true;  // Anyone can read
      allow create: if request.auth != null;  // Only authenticated users can create
      allow update, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    */
  }
}
